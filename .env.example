# Token bot dari @BotFather
BOT_TOKEN=123456789:isi-token-bot-anda

# ID Telegram numerik owner (boleh lebih dari satu, pisahkan dengan koma)
OWNER_IDS=123456789

# ===== Mode deploy untuk index.js (Railway / Render / lokal) =====
# USE_WEBHOOK tidak berpengaruh saat deploy ke Vercel (Vercel selalu pakai api/webhook.js).
# true  = webhook lewat server Express bawaan index.js (disarankan untuk Railway/Render)
# false = long polling (disarankan untuk development lokal)
USE_WEBHOOK=false

# Wajib diisi jika USE_WEBHOOK=true (Railway/Render), atau saat menjalankan
# `npm run webhook:set` untuk deploy Vercel.
# Contoh Railway/Render: https://namaapp.up.railway.app
# Contoh Vercel        : https://nama-app-anda.vercel.app
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/webhook/secret-path
PORT=3000

# Token rahasia opsional untuk validasi header X-Telegram-Bot-Api-Secret-Token.
# Sangat dianjurkan diisi saat deploy ke Vercel karena URL /api/webhook bersifat tetap.
WEBHOOK_SECRET=

# Lokasi file database SQLite.
# Di Vercel otomatis memakai /tmp/apis.db jika DB_PATH tidak diisi (lihat README).
DB_PATH=./database/apis.db

# Pengaturan anti-flood & anti-raid
FLOOD_LIMIT=5
FLOOD_INTERVAL_MS=6000
RAID_JOIN_LIMIT=8
RAID_INTERVAL_MS=15000
MAX_WARN=3
